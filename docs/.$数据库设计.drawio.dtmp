     datetime deleted_at\n    }\n\n    sms_codes {\n        char36 id PK\n        varchar phone\n        varchar code\n        varchar purpose\n        datetime expires_at\n        datetime used_at\n        varchar request_ip\n        datetime created_at\n    }\n\n    auth_sessions {\n        char36 id PK\n        char36 user_id FK\n        varchar refresh_token_hash UK\n        varchar device_info\n        datetime expires_at\n        datetime revoked_at\n        datetime created_at\n    }\n\n    user_preferences {\n        char36 user_id PK_FK\n        varchar preferred_lang\n        decimal font_scale\n        boolean high_contrast\n        datetime updated_at\n    }\n\n    media_files {\n        char36 id PK\n        char36 user_id FK\n        varchar kind\n        varchar mime_type\n        varchar storage_key\n        varchar url\n        bigint size_bytes\n        varchar checksum\n        datetime created_at\n        datetime deleted_at\n    }\n\n    voice_recognize_jobs {\n        char36 id PK\n        char36 user_id FK\n        char36 media_id FK\n        varchar lang\n        text recognized_text\n        int duration_ms\n        varchar status\n        text error_message\n        datetime created_at\n    }\n\n    qa_sessions {\n        char36 id PK\n        char36 user_id FK\n        varchar lang\n        varchar input_mode\n        text question_text\n        text answer_text\n        char36 audio_media_id FK\n        char36 voice_job_id FK\n        datetime created_at\n        datetime deleted_at\n    }\n\n    qa_recommendations {\n        char36 id PK\n        char36 session_id FK_UK\n        char36 user_id FK\n        varchar title\n        text body\n        varchar risk_level\n        text disclaimer\n        datetime created_at\n    }\n\n    medical_archives {\n        char36 id PK\n        char36 user_id FK\n        text diagnosis\n        text medicine\n        date visit_date\n        text raw_ocr_text\n        char36 image_media_id FK\n        varchar source\n        datetime created_at\n        datetime updated_at\n        datetime deleted_at\n    }\n\n    archive_ocr_jobs {\n        char36 id PK\n        char36 user_id FK\n        char36 image_media_id FK\n        varchar source\n        text diagnosis\n        text medicine\n        date visit_date\n        text raw_ocr_text\n        varchar status\n        datetime created_at\n    }\n\n    health_summaries {\n        char36 id PK\n        char36 user_id FK\n        varchar title\n        date exam_date\n        varchar exam_no\n        text summary_text\n        datetime created_at\n        datetime updated_at\n        datetime deleted_at\n    }\n\n    health_summary_items {\n        char36 id PK\n        char36 summary_id FK\n        int sort_order\n        text content\n        varchar severity\n        datetime created_at\n    }\n\n    health_reports {\n        char36 id PK\n        char36 user_id FK\n        varchar patient_name\n        date exam_date\n        varchar org_name\n        varchar voucher_no\n        varchar report_type\n        char36 pdf_media_id FK\n        json raw_payload\n        datetime created_at\n        datetime updated_at\n        datetime deleted_at\n    }\n\n    health_report_findings {\n        char36 id PK\n        char36 report_id FK\n        int sort_order\n        text title\n        text suggestion\n        varchar risk_level\n        datetime created_at\n    }\n\n    report_glossaries {\n        char36 id PK\n        varchar term\n        text definition\n        int sort_order\n        boolean enabled\n        datetime created_at\n    }\n\n    family_contacts {\n        char36 id PK\n        char36 user_id FK\n        varchar name\n        varchar phone\n        varchar relation\n        datetime created_at\n        datetime updated_at\n        datetime deleted_at\n    }\n\n    family_push_rules {\n        char36 user_id PK_FK\n        boolean on_record_saved\n        boolean on_abnormal\n        boolean on_visit\n        datetime updated_at\n    }\n\n    archive_shares {\n        char36 id PK\n        char36 archive_id FK\n        char36 user_id FK\n        char36 contact_id FK\n        text message\n        varchar status\n        datetime created_at\n        datetime sent_at\n    }\n\n    archive_exports {\n        char36 id PK\n        char36 archive_id FK\n        char36 user_id FK\n        char36 pdf_media_id FK\n        varchar download_url\n        datetime expires_at\n        varchar status\n        datetime created_at\n    }\n\n    audit_logs {\n        bigint id PK\n        char36 user_id\n        varchar action\n        varchar resource\n        char36 resource_id\n        json detail\n        varchar ip\n        datetime created_at\n    }\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CkMxkbogL1gPlGqpj-bp-1">
