APP_NAME=AI FastAPI Backend
APP_ENV=local
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
WS_V1_PREFIX=/ws/v1
LOG_LEVEL=INFO
ACCESS_LOG=true
CORS_ORIGINS=["*"]
AI_GATEWAY_PROVIDER=echo
AI_GATEWAY_TIMEOUT_SECONDS=60
MAX_WS_CONNECTIONS=10000
# MySQL 8（推荐，与 docs/database/schema.sql 一致）
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/senior_voice?charset=utf8mb4
# SQLite local（开发/单测）
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL（可选）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/app
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_MAX_CONNECTIONS=100
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SMS_CODE_EXPIRE_SECONDS=300
SMS_RATE_LIMIT_SECONDS=60
SMS_CODE_LENGTH=6
SMS_DEV_CODE=123456
TELEMETRY_ENABLED=false
TELEMETRY_SERVICE_NAME=ai-fastapi-backend
TELEMETRY_OTLP_ENDPOINT=
TASK_WORKER_COUNT=2
TASK_QUEUE_MAX_SIZE=1000
