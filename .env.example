APP_NAME=AI FastAPI Backend
APP_ENV=local
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
WS_V1_PREFIX=/ws/v1
LOG_LEVEL=INFO
ACCESS_LOG=true
CORS_ORIGINS=["*"]
# echo | reverse-echo | openai（OpenAI 兼容 /chat/completions；生产请用 openai）
AI_GATEWAY_PROVIDER=openai
AI_GATEWAY_TIMEOUT_SECONDS=120
# provider=openai 时生效；api_base 可换 DeepSeek / vLLM / Ollama 等
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 语音输入→文本输出模型（OpenAI audio chat）
OPENAI_AUDIO_MODEL=gpt-audio
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024
# 可选代理（推荐显式配置；勿只依赖 ALL_PROXY=socks，易导致请求卡住）
OPENAI_HTTP_PROXY=http://127.0.0.1:7890
MAX_WS_CONNECTIONS=10000
# MySQL 8（默认，与 docs/database/schema.sql 一致）
DATABASE_URL=mysql+aiomysql://root:123456@127.0.0.1:3306/senior_voice?charset=utf8mb4
# SQLite（单测由 tests/conftest.py 覆盖）
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL（可选）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/app
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
REDIS_URL=redis://localhost:6379/0
# 生产/联调建议 true；false 时文字问答上下文走进程内存（重启丢失）
REDIS_ENABLED=false
REDIS_MAX_CONNECTIONS=100
# 适老化问答上下文 TTL（秒），自创建起固定 30 天，期内提问不续期
QA_CONTEXT_TTL_SECONDS=2592000
QA_CONTEXT_HISTORY_LIMIT=40
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SMS_CODE_EXPIRE_SECONDS=300
SMS_RATE_LIMIT_SECONDS=60
SMS_CODE_LENGTH=6
SMS_DEV_CODE=123456
TELEMETRY_ENABLED=false
TELEMETRY_SERVICE_NAME=ai-fastapi-backend
TELEMETRY_OTLP_ENDPOINT=
TASK_WORKER_COUNT=2
TASK_QUEUE_MAX_SIZE=1000
